---
import '../../styles/docs.css';

import { base, documentationPages } from '../../content/documentation.js';

export async function getStaticPaths() {
  const pages = await documentationPages();
  return pages.map(page => ({
    params: { slug: page.slug === 'installation' ? undefined : page.slug },
    props: { page, pageLinks: pages },
  }));
}

const { page, pageLinks } = Astro.props;
const activeIndex = pageLinks.findIndex(entry => entry.slug === page.slug);
const current = pageLinks[activeIndex];
const groups = [...new Set(pageLinks.map(({ group }) => group))];
const { Content } = page;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LaravelJS framework concept documentation" />
    <title>{current.title} | LaravelJS Documentation</title>
    <link rel="icon" href={base + '/assets/icon.svg'} />
  </head>
  <body>
    <a class="docs-skip" href="#article">Skip to content</a>
    <header class="docs-header">
      <a class="docs-logo" href={base + '/'} aria-label="LaravelJS home">LaravelJS</a>
      <button class="docs-search-trigger" type="button" aria-label="Search documentation" data-search-open>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" /></svg>
        <kbd>⌘K</kbd>
      </button>
      <div class="docs-controls">
        <span class="docs-version">Preview</span>
        <select aria-label="Color theme" data-theme-select>
          <option value="system">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
        <button type="button" class="docs-menu" aria-expanded="false" aria-controls="docs-navigation" aria-label="Documentation navigation">☰</button>
      </div>
    </header>
    <div class="docs-layout">
      <nav id="docs-navigation" class="docs-sidebar" aria-label="Documentation">
        {groups.map(group => (
          <details open={group === current.group}>
            <summary>{group}</summary>
            {pageLinks.filter(entry => entry.group === group).map(entry => (
              <a href={entry.href} aria-current={entry.href === current.href ? 'page' : undefined}>{entry.title}</a>
            ))}
          </details>
        ))}
      </nav>
      <main id="article" class="docs-main">
        <h1>{current.title}</h1>
        <nav class="docs-outline" aria-label="On this page">
          <span>☰ &nbsp; On this page</span>
          <ul>
            {current.headings.map(heading => (
              <li class:list={[heading.depth === 3 && 'docs-subheading']}><a href={'#' + heading.slug}>{heading.text}</a></li>
            ))}
          </ul>
        </nav>
        <article><Content /></article>
        <nav class="docs-pagination" aria-label="Other documentation pages">
          {pageLinks[activeIndex - 1] && <a href={pageLinks[activeIndex - 1].href}>← {pageLinks[activeIndex - 1].title}</a>}
          {pageLinks[activeIndex + 1] && <a href={pageLinks[activeIndex + 1].href}>{pageLinks[activeIndex + 1].title} →</a>}
        </nav>
      </main>
    </div>
    <dialog class="docs-search-dialog" aria-label="Search documentation">
      <form method="dialog" class="docs-search-header">
        <input type="search" placeholder="Search documentation" aria-label="Search documentation" />
        <button value="close" aria-label="Close search">Esc</button>
      </form>
      <div class="docs-results">
        {pageLinks.map(entry => (
          <div>
            <a href={entry.href}>{entry.title}</a>
            {entry.headings.map(heading => <a href={entry.href + '#' + heading.slug}>{entry.title} › {heading.text}</a>)}
          </div>
        ))}
        <p role="status" hidden>No matching results.</p>
      </div>
    </dialog>
    <script src="../../scripts/docs.js"></script>
  </body>
</html>
