---
import { Code } from 'astro:components';
import { examples } from '../content/landing-examples.js';
import { documentationPages, docsRoot } from '../content/documentation.js';

const initialFiles = examples.Auth;
const docsEntries = await documentationPages();
const footerGroups = [
  ['Framework', [['Overview', '#framework'], ['Code examples', '#examples'], ['Frontend integrations', '#frontend']]],
  ['Documentation', docsEntries.map(page => [page.title, page.href])],
  ['Concepts', [['Deployment', '#cloud'], ['Preview environments', '#previews'], ['Observability', '#observability']]],
  ['Project', [['Design principles', '#principles'], ['Updates', '#updates']]],
];
const ecosystem = [
  { name: 'TypeScript', logo: 'typescript' },
  { name: 'Node.js', logo: 'nodejs' },
  { name: 'React', logo: 'react' },
  { name: 'Vue', logo: 'vuejs' },
  { name: 'Svelte', logo: 'svelte' },
  { name: 'PostgreSQL', logo: 'postgresql' },
  { name: 'Vite', logo: 'vitejs' },
];
