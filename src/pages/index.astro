  </div>
</template>
{Object.entries(examples).map(([category, files]) => (
  <template data-example-category={category}>
    {files.map(([filename, code]) => (
      <div data-filename={filename}><Code code={code} lang="typescript" theme="light-plus" wrap={null} tabindex={-1} /></div>
    ))}
  </template>
))}
<template id="landing-doc-search">
  {docsEntries.map(entry => <a href={entry.href} data-description={'Documentation · ' + entry.group}>{entry.title}</a>)}
  {docsEntries.flatMap(entry => entry.headings.map(heading => (
    <a href={entry.href + '#' + heading.slug} data-description={'Documentation · ' + entry.title}>{heading.text}</a>
  )))}
</template>
<dialog id="search-dialog" class="ljs-search" aria-label="Search docs">
<form method="dialog" class="ljs-searchbar">
  <input type="search" placeholder="Search docs" aria-label="Search docs" autocomplete="off">
  <button type="button" data-search-clear aria-label="Clear the query" hidden>
    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="8" /><path d="m7 7 6 6m0-6-6 6" /></svg>
  </button>
  <button value="close" aria-label="Close search">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><path d="m5 5 10 10m0-10L5 15" /></svg>
  </button>
</form>
<div class="ljs-search-results" aria-live="polite" hidden></div>
<div class="ljs-search-footer">Search LaravelJS docs and examples <span aria-hidden="true">↑↓ Navigate &nbsp; ↵ Select &nbsp; ESC Close</span></div>
</dialog>
</body></html>
