00%"></rect></svg></div></div><h2 class="font-display mx-auto max-w-3xl text-center text-4xl tracking-tighter text-balance sm:text-5xl md:text-6xl">Create without limits. What will you build?</h2><div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row"><a class="group/button relative isolate inline-flex cursor-pointer items-center justify-center rounded-lg text-sm tracking-tight shadow-xs select-none border border-transparent text-center font-medium whitespace-nowrap transition-colors duration-50 ease-out focus:outline-hidden focus-visible:ring-3 bg-laravel-red text-white ring-laravel-red/40 hover:bg-laravel-red-darkened h-10 gap-2 px-4" href="#cloud">Explore hosting<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4 transition-transform duration-100 ease-out group-hover/button:translate-x-0.5"><path fill-rule="evenodd" d="M2 10a.75.75 0 0 1 .75-.75h12.59l-2.1-1.95a.75.75 0 1 1 1.02-1.1l3.5 3.25a.75.75 0 0 1 0 1.1l-3.5 3.25a.75.75 0 1 1-1.02-1.1l2.1-1.95H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd"></path></svg></a><a class="group/button relative isolate inline-flex cursor-pointer items-center justify-center rounded-lg text-sm tracking-tight shadow-xs select-none border text-center font-medium whitespace-nowrap transition-colors duration-50 ease-out focus:outline-hidden focus-visible:ring-3 border-neutral-200 bg-white text-strong ring-neutral-900/10 hover:bg-neutral-50 focus-visible:border-neutral-300 h-10 gap-2 px-4" href={docsRoot}>View framework docs<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="size-4 text-laravel-red transition-transform duration-100 ease-out group-hover/button:translate-x-px group-hover/button:-translate-y-px"><path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l7.22-7.22v5.69a.75.75 0 0 0 1.5 0v-7.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0 0 1.5h5.69l-7.22 7.22a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd"></path></svg></a></div><div class="absolute -top-[4px] -left-[4px] size-[7px] bg-laravel-red" aria-hidden="true"></div><div class="absolute -top-[4px] -right-[4px] size-[7px] bg-laravel-red" aria-hidden="true"></div></div></div><div class="relative border-neutral-200 border-t" id="principles" tabindex="-1"><div class="absolute inset-0 z-0 bg-white"><div class="absolute inset-0 ljs-principles-glow"></div><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="pointer-events-none absolute inset-0 z-[99] overflow-hidden mix-blend-overlay" width="100%" height="100%" preserveaspectratio="none"><defs><filter id="_R_4r7_-noise-filter"><feturbulence type="turbulence" basefrequency="3" numoctaves="1" stitchtiles="stitch" result="noise"></feturbulence><fecolormatrix type="matrix" values="0 0 0 0 0
